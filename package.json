{
  "name": "podnebesnaya",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:map": "tsx scripts/validate-map.ts",
    "validate:fonts": "tsx scripts/validate-fonts.ts",
    "generate:callouts": "tsx scripts/generate-callouts.ts",
    "generate:palette": "tsx scripts/generate-region-palette.ts",
    "generate:hit-targets": "tsx scripts/generate-hit-targets.ts",
    "generate:fonts": "tsx scripts/generate-fonts.ts",
    "extract:canal": "tsx scripts/extract-canal-source.ts",
    "extract:physical": "tsx scripts/extract-physical-source.ts",
    "extract:countries": "tsx scripts/extract-countries-source.ts",
    "extract:relief": "tsx scripts/extract-relief-source.ts",
    "fetch:photos": "tsx scripts/fetch-collection-photos.ts",
    "generate:physical": "tsx scripts/generate-physical-geometry.ts",
    "generate:countries": "tsx scripts/generate-country-geometry.ts",
    "generate:relief": "tsx scripts/generate-relief-bands.ts",
